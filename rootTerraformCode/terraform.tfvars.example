# Copy to terraform.tfvars (git-ignored) and fill in.
alert_email = "you@example.com"

# S3 bucket names are global across all AWS accounts. If you are not the
# original author, pick a unique prefix (lowercase letters, digits, hyphens).
# project = "qf-yourname"

# Optional overrides
